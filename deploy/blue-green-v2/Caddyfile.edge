{
	admin unix//run/bgv2/admin.sock|0600
	auto_https disable_redirects
	skip_install_trust

	servers :80 {
		name redirect
	}
	servers :443 {
		name public
		strict_sni_host on
		protocols h1 h2
	}
	servers 127.0.0.1:8443 {
		name preview-green
		strict_sni_host on
		protocols h1 h2
	}
	servers 127.0.0.1:8444 {
		name preview-blue
		strict_sni_host on
		protocols h1 h2
	}

	log {
		exclude http.log.error
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				headers delete
				error delete
			}
		}
	}
}

(tls-config) {
	{$BGV2_TLS_DIRECTIVE:tls internal}
}

(upstream) {
	header X-Request-ID {http.request.uuid}
	log_append <route_generation {args[1]}
	log_append <ingress {args[2]}
	log_append <received_at_ms {time.now.unix_ms}
	log_append <request_id {http.request.uuid}
	log_append upstream {http.reverse_proxy.upstream.hostport}
	log_append proxy_ms {http.reverse_proxy.duration_ms}
	log_append proxy_retries {http.reverse_proxy.retries}
	log_append upstream_status {http.reverse_proxy.status_code}
	log_append upstream_headers_ms {http.reverse_proxy.upstream.latency_ms}

	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up Host {host}
		header_up -X-Real-IP
		header_up -Forwarded
		header_up X-Request-ID {http.request.uuid}
		header_down -X-Request-ID
	}
}

(api-class) {
	@heartbeat {
		method POST
		path /api/player/heartbeat
	}
	log_append @heartbeat <endpoint heartbeat
	@playback {
		method POST
		path /api/player/playback-events
	}
	log_append @playback <endpoint playback-events
	@channels {
		method GET
		path /api/channels/
	}
	log_append @channels <endpoint channels
	@runtime {
		method GET
		path_regexp edge_runtime ^/api/channels/[0-9a-fA-F-]{36}/runtime-config$
	}
	log_append @runtime <endpoint admin-runtime
}

(preview-api) {
	@read expression `(method('GET', 'HEAD') && (path('/', '/api/player/time', '/api/auth/me', '/api/channels/', '/openapi.json', '/media/*') || path_regexp('preview_runtime', '^/api/channels/[0-9a-fA-F-]{36}/runtime-config$'))) && !header({'Upgrade': '*'})`
	handle @read {
		import api-class
		import upstream {args[0]} preview {args[1]}
	}
	handle {
		respond 403
	}
}

(preview-frontend) {
	@read expression `method('GET', 'HEAD') && !header({'Upgrade': '*'})`
	handle @read {
		import upstream {args[0]} preview {args[1]}
	}
	handle {
		respond 403
	}
}

http://{$BGV2_API_HOST:api.tecnocontrolcloud.com}, http://{$BGV2_APP_HOST:app.tecnocontrolcloud.com} {
	redir https://{host}{uri} 308
}

{$BGV2_API_HOST:api.tecnocontrolcloud.com} {
	import tls-config
	log
	import api-class
	import upstream backend-blue:8000 0 public
}

{$BGV2_APP_HOST:app.tecnocontrolcloud.com} {
	import tls-config
	log
	import upstream frontend-blue:80 0 public
}

https://{$BGV2_API_HOST:api.tecnocontrolcloud.com}:8443 {
	bind 127.0.0.1
	import tls-config
	log
	import preview-api backend-green:8000 preview-green
}

https://{$BGV2_APP_HOST:app.tecnocontrolcloud.com}:8443 {
	bind 127.0.0.1
	import tls-config
	log
	import preview-frontend frontend-green:80 preview-green
}

https://{$BGV2_API_HOST:api.tecnocontrolcloud.com}:8444 {
	bind 127.0.0.1
	import tls-config
	log
	import preview-api backend-blue:8000 preview-blue
}

https://{$BGV2_APP_HOST:app.tecnocontrolcloud.com}:8444 {
	bind 127.0.0.1
	import tls-config
	log
	import preview-frontend frontend-blue:80 preview-blue
}
