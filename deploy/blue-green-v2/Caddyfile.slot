{
	admin off
	auto_https off
	persist_config off
}

:80 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; img-src 'self' http: https: data: blob:; font-src https://fonts.gstatic.com; connect-src 'self' https://{$BGV2_API_HOST:api.tecnocontrolcloud.com}; media-src 'self' http: https: data: blob:; frame-src http: https:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'none';"
	}
	root * /srv
	encode zstd gzip
	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
